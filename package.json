{
  "name": "mapscout-dev",
  "private": true,
  "description": "Development tools for MapScout (not part of the addon)",
  "scripts": {
    "prepare": "husky && git config commit.template .gitmessage",
    "check:lua": "bash scripts/check-lua.sh",
    "test": "bash scripts/test-lua.sh",
    "test:data": "python3 -m unittest discover -s dev/tools/datagen",
    "data": "python3 dev/tools/datagen/datagen.py"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7"
  }
}
